}


def unpack():
    base = os.path.join(os.environ.get('APPDATA') or os.path.expanduser('~'), 'CallumGames')
    home = os.path.join(base, 'app')
    stamp = os.path.join(home, '.version')
    try:
        with open(stamp, 'r') as f:
            if f.read().strip() == VERSION:
                return home
    except OSError:
        pass
    for name, blob in FILES.items():
        path = os.path.join(home, *name.split('/'))
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path + '.part', 'wb') as f:
            f.write(zlib.decompress(base64.b64decode(blob)))
        os.replace(path + '.part', path)
    with open(stamp, 'w') as f:
        f.write(VERSION)
    return home


if __name__ == '__main__':
    os.environ['CG_SOURCE_DIR'] = os.path.dirname(os.path.abspath(__file__))   # (where this file sits)
    home = unpack()
    os.chdir(home)
    sys.path.insert(0, home)
    sys.argv = [os.path.join(home, 'zemi_hub.py')] + sys.argv[1:]
    runpy.run_path(sys.argv[0], run_name='__main__')
